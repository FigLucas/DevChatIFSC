# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env com valores reais!

# Chave da Mistral AI (https://console.mistral.ai/)
MISTRAL_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção, a API recusa chaves com menos de 32 caracteres.
SECRET_KEY=
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=ifsc-chat-api
JWT_AUDIENCE=ifsc-chat-web
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Obrigatório em produção; use apenas nomes de host, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# Gere uma entrada com: cd backend && python create_user.py SEU_USUARIO --name "Seu Nome"
# Prefira AUTH_USERS_FILE em produção (arquivo montado como secret).
AUTH_USERS_JSON=
AUTH_USERS_FILE=
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
MAX_CONCURRENT_CHATS=8

# RAG: a busca web pode ser off, fallback (quando a base é insuficiente/atual) ou always
RAG_WEB_SEARCH_MODE=fallback
RAG_TOP_K=6
RAG_FETCH_K=20
RAG_MAX_PER_SOURCE=3
RAG_MAX_CONTEXT_CHARS=12000
RAG_MIN_DENSE_SCORE=0.25
RAG_MIN_LEXICAL_OVERLAP=0.25
RAG_WEB_MAX_RESULTS=4
RAG_ALLOWED_WEB_DOMAINS=usp.br,fapesp.br,cnpq.br,capes.gov.br,gov.br
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_MAX_TOKENS=2000
MISTRAL_MAX_RETRIES=2
MISTRAL_TIMEOUT_SECONDS=90

# URL base da API do backend (usado pelo Vite)
VITE_API_URL=http://localhost:8000
